{
  "name": "raramuri-digital",
  "version": "3.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/typed-variants.test.mjs tests/lexical-relations-public.test.mjs tests/candidate-layer-apis.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:variants": "node scripts/extract-graphic-variants.mjs",
    "data:typed-variants": "node scripts/generate-typed-variants.mjs",
    "data:saltillo": "node scripts/extract-glottal-stop-words.mjs",
    "data:accents": "node --no-warnings scripts/extract-accented-words.mjs",
    "data:inventories": "node scripts/extract-grammatical-inventories.mjs",
    "data:advanced": "node --experimental-strip-types --no-warnings scripts/extract-advanced-products.mjs && node scripts/reconcile-remission-product.mjs",
    "data:cldf": "node scripts/generate-cldf.mjs",
    "data:orthography": "node scripts/generate-orthography-profile.mjs",
    "data:tei": "node scripts/generate-interoperability-exports.mjs && node scripts/normalize-tei-lex0.mjs",
    "data:exports": "node scripts/generate-typed-variants.mjs && node scripts/extract-graphic-variants.mjs && node --experimental-strip-types --no-warnings scripts/extract-advanced-products.mjs && node scripts/reconcile-remission-product.mjs && node scripts/generate-interoperability-exports.mjs && node scripts/normalize-tei-lex0.mjs && node scripts/generate-cldf.mjs && node scripts/generate-orthography-profile.mjs",
    "data:quality": "node scripts/generate-quality-report.mjs",
    "data:pdf": "python3 scripts/generate-pdf-exports.py",
    "validate:cldf": "python -m pycldf validate public/downloads/cldf/cldf-metadata.json",
    "validate": "npm run data:exports && npm run data:quality && npm run lint && npm test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.122.0"
  },
  "type": "module"
}